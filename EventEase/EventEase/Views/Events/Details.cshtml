@model EventEase.Models.Event

@{
    ViewData["Title"] = "Event Details";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-5 gap-3">
        <div>
            <h1 class="fw-bold text-dark mb-1">@Model.EventName</h1>
            <p class="text-muted mb-0">
                
                    <span class="fst-italic">No date scheduled</span>
                
            </p>
        </div>

        <div class="d-flex gap-3 flex-wrap">
            <a asp-action="Edit" asp-route-id="@Model.EventID" class="btn btn-primary shadow-sm px-4">
                <i class="bi bi-pencil me-2"></i> Edit Event
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary shadow-sm px-4">
                <i class="bi bi-arrow-left me-2"></i> Back to Events
            </a>
            <a asp-action="Delete" asp-route-id="@Model.EventID" class="btn btn-outline-danger shadow-sm px-4">
                <i class="bi bi-trash me-1"></i> Delete
            </a>
        </div>
    </div>

    <!-- Main Content Card -->
    <div class="card border-0 shadow-lg rounded-4 bg-white overflow-hidden">
        <div class="row g-0">
            <!-- Left side - Visual / Banner area -->
            <div class="col-lg-5">
                <div class="event-banner position-relative h-100"
                     style="min-height: 380px; background: linear-gradient(135deg, #e9ecef, #dee2e6);">
                    <!-- Optional: Event banner / placeholder -->
                    <div class="d-flex align-items-center justify-content-center h-100 text-muted">
                        <div class="text-center">
                            <i class="bi bi-calendar-event fs-1 mb-3 d-block"></i>
                            <p class="mb-0">Event Visual / Banner</p>
                            <small>(Add ImageUrl field later if needed)</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right side - Details -->
            <div class="col-lg-7">
                <div class="p-4 p-lg-5">
                    <h4 class="fw-semibold mb-4 pb-3 border-bottom">
                        <i class="bi bi-info-circle me-2 text-primary"></i>
                        Event Information
                    </h4>

                    <dl class="row g-4 mb-0">
                        <dt class="col-sm-3 fw-medium text-muted">Event Name</dt>
                        <dd class="col-sm-9 fs-5 fw-semibold">@Model.EventName</dd>

                        <dt class="col-sm-3 fw-medium text-muted">Date & Time</dt>
                        <dd class="col-sm-9 fs-5">
                            
                        </dd>

                        <dt class="col-sm-3 fw-medium text-muted">Venue</dt>
                        <dd class="col-sm-9 fs-5">
                            @if (Model.Venue != null)
                            {
                                <strong>@Model.Venue.VenueName</strong>
                                <div class="text-muted small mt-1">
                                    <i class="bi bi-geo-alt-fill me-1"></i>@Model.Venue.Location
                                </div>
                            }
                            else
                            {
                                <span class="text-muted fst-italic">No venue assigned</span>
                            }
                        </dd>

                        <dt class="col-sm-3 fw-medium text-muted">Description</dt>
                        <dd class="col-sm-9">
                            @if (!string.IsNullOrWhiteSpace(Model.Description))
                            {
                                <div class="text-dark" style="white-space: pre-wrap; line-height: 1.6;">
                                    @Model.Description
                                </div>
                            }
                            else
                            {
                                <span class="text-muted fst-italic">No description provided</span>
                            }
                        </dd>

                        <dt class="col-sm-3 fw-medium text-muted">Event ID</dt>
                        <dd class="col-sm-9 text-muted small">@Model.EventID</dd>
                    </dl>

                    <!-- Optional status badge -->
                    <div class="mt-5 pt-4 border-top">
                        <span class="badge @(Model.EventDate > DateTime.Now ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary") px-4 py-2 fs-6">
                            @(Model.EventDate > DateTime.Now ? "Upcoming Event" : "Past Event")
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
