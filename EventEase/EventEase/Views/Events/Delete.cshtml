@model EventEase.Models.Event

@{
    ViewData["Title"] = "Delete Event";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h1 class="fw-bold text-dark mb-1">Delete Event</h1>
            <p class="text-muted mb-0">Confirm removal of <strong>@Model.EventName</strong></p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary shadow-sm px-4">
            <i class="bi bi-arrow-left me-2"></i> Back to Events
        </a>
    </div>

    <!-- Confirmation Card -->
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white">
                <div class="card-header bg-danger-subtle border-0 py-4 d-flex align-items-center">
                    <i class="bi bi-exclamation-triangle-fill text-danger fs-3 me-3"></i>
                    <h4 class="mb-0 fw-semibold text-danger">
                        Confirm Deletion
                    </h4>
                </div>

                <div class="card-body p-4 p-md-5">
                    <p class="lead text-center mb-5 text-muted">
                        Are you sure you want to permanently delete this event?<br />
                        <strong>This action cannot be undone.</strong>
                    </p>

                    <!-- Event Details Preview -->
                    <div class="card bg-light border-0 shadow-sm mb-5">
                        <div class="card-body">
                            <h4 class="fw-bold mb-4 text-dark">@Model.EventName</h4>

                            <dl class="row g-3 mb-0">
                                <dt class="col-sm-3 text-muted">Date & Time</dt>
                                <dd class="col-sm-9">
                                    
                                        <span class="text-muted fst-italic">No date set</span>
                                    
                                </dd>

                                <dt class="col-sm-3 text-muted">Venue</dt>
                                <dd class="col-sm-9">
                                    @if (Model.Venue != null)
                                    {
                                        @Model.Venue.VenueName
                                        <small class="text-muted d-block">(@Model.Venue.Location)</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">No venue assigned</span>
                                    }
                                </dd>

                                <dt class="col-sm-3 text-muted">Description</dt>
                                <dd class="col-sm-9">
                                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                                    {
                                        <div class="text-muted" style="white-space: pre-wrap;">
                                            @(Model.Description.Length > 300
                                                                                    ? Model.Description.Substring(0, 300) + "..."
                                                                                    : Model.Description)
                                    </div>
                                                                        }
                                    else
                                    {
                                        <span class="text-muted fst-italic">No description</span>
                                    }
                                </dd>

                                <dt class="col-sm-3 text-muted">Event ID</dt>
                                <dd class="col-sm-9 text-muted small">@Model.EventID</dd>
                            </dl>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="EventID" />

                        <div class="d-flex gap-3 justify-content-center mt-5 pt-4 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary px-5 py-3 fs-5">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-danger px-5 py-3 fs-5 shadow">
                                <i class="bi bi-trash-fill me-2"></i> Yes, Delete Event
                            </button>
                        </div>
                    </form>
                </div>

                <div class="card-footer bg-light border-0 text-center py-3 small text-muted">
                    Deleting this event will remove it from all records and schedules
                </div>
            </div>
        </div>
    </div>
</div>

