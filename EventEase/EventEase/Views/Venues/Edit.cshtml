@model EventEase.Models.Venue

@{
    ViewData["Title"] = "Edit Venue";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h1 class="fw-bold text-dark mb-1">Edit Venue</h1>
            <p class="text-muted mb-0">Update the details for this event space</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary shadow-sm px-4">
            <i class="bi bi-arrow-left me-2"></i> Back to Venues
        </a>
    </div>

    @if (TempData["AlertMessage"] != null)
    {
        <div class="alert alert-@TempData["AlertType"] alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["AlertMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white">
                <div class="card-header border-0 py-4">
                    <h4 class="mb-0 fw-semibold text-dark">
                        <i class="bi bi-pencil-square me-2 text-warning"></i>Update Venue Information
                    </h4>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="VenueID" />
                        <input type="hidden" asp-for="ImageUrl" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-4">
                            <label asp-for="VenueName" class="form-label fw-medium text-dark"></label>
                            <input asp-for="VenueName" class="form-control form-control-lg shadow-sm" />
                            <span asp-validation-for="VenueName" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Location" class="form-label fw-medium text-dark"></label>
                            <input asp-for="Location" class="form-control form-control-lg shadow-sm" />
                            <span asp-validation-for="Location" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Capacity" class="form-label fw-medium text-dark"></label>
                            <div class="input-group input-group-lg">
                                <input asp-for="Capacity" class="form-control shadow-sm" type="number" min="1" />
                                <span class="input-group-text bg-light">people</span>
                            </div>
                            <span asp-validation-for="Capacity" class="text-danger small"></span>
                        </div>

                        <!-- Current Image + New Upload -->
                        <div class="mb-5">
                            <label class="form-label fw-medium text-dark">Venue Image</label>
                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <div class="mb-2">
                                    <small class="text-muted d-block mb-1">Current image (stored in Azure Blob Storage):</small>
                                    <img src="@Model.ImageUrl" alt="Current venue image" class="rounded-3 shadow-sm"
                                         style="height:120px; max-width:300px; object-fit:cover;" />
                                </div>
                            }
                            <input type="file" name="ImageFile" class="form-control shadow-sm mt-2"
                                   accept="image/*" id="imageFileInput" />
                            <div class="form-text text-muted small">
                                <i class="bi bi-cloud-upload me-1 text-primary"></i>
                                Upload a new image to replace the current one in Azure Blob Storage. Leave blank to keep existing.
                            </div>
                            <div class="mt-2" id="imagePreviewContainer" style="display:none;">
                                <img id="imagePreview" src="#" alt="New preview" class="rounded-3 shadow-sm"
                                     style="max-height:120px; max-width:300px; object-fit:cover;" />
                            </div>
                        </div>

                        <div class="d-flex gap-3 justify-content-end mt-5 pt-4 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary px-5 py-2">Cancel</a>
                            <button type="submit" class="btn btn-warning px-5 py-2 shadow">
                                <i class="bi bi-save me-2"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.getElementById('imageFileInput').addEventListener('change', function (e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (ev) {
                    document.getElementById('imagePreview').src = ev.target.result;
                    document.getElementById('imagePreviewContainer').style.display = 'block';
                };
                reader.readAsDataURL(file);
            }
        });
    </script>
}
