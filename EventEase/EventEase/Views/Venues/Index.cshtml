@model IEnumerable<EventEase.Models.Venue>

@{
    ViewData["Title"] = "Venues";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold text-dark mb-1">Venues</h1>
            <p class="text-muted mb-0">Manage your event spaces</p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm px-4">
            <i class="bi bi-plus-lg me-2"></i> New Venue
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-lg-4 col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" class="card-img-top" alt="@item.VenueName"
                             style="height:200px; object-fit:cover;" />
                    }
                    else
                    {
                        <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height:200px;">
                            <i class="bi bi-building fs-1 text-muted"></i>
                        </div>
                    }
                    <div class="card-body">
                        <h5 class="fw-bold">@item.VenueName</h5>
                        <p class="text-muted small mb-1"><i class="bi bi-geo-alt me-1"></i>@item.Location</p>
                        <p class="text-muted small"><i class="bi bi-people me-1"></i>Capacity: @item.Capacity</p>
                    </div>
                    <div class="card-footer bg-transparent border-0 d-flex gap-2 pb-3">
                        <a asp-action="Details" asp-route-id="@item.VenueID" class="btn btn-sm btn-outline-primary flex-fill">Details</a>
                        <a asp-action="Edit" asp-route-id="@item.VenueID" class="btn btn-sm btn-outline-secondary flex-fill">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.VenueID" class="btn btn-sm btn-outline-danger flex-fill">Delete</a>
                    </div>
                </div>
            </div>
        }
        @if (!Model.Any())
        {
            <div class="col-12">
                <div class="alert alert-info text-center py-5 border-0 shadow-sm">
                    <i class="bi bi-building-x fs-1 d-block mb-3 text-muted"></i>
                    <h5>No venues found</h5>
                    <a asp-action="Create" class="btn btn-primary">Add First Venue</a>
                </div>
            </div>
        }
    </div>
</div>
