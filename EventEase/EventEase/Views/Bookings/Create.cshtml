@model EventEase.Models.Booking

@{
    ViewData["Title"] = "New Booking";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h1 class="fw-bold text-dark mb-1">New Booking</h1>
            <p class="text-muted mb-0">Reserve a venue for an event</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary shadow-sm px-4">
            <i class="bi bi-arrow-left me-2"></i> Back to Bookings
        </a>
    </div>

    @if (TempData["AlertMessage"] != null)
    {
        <div class="alert alert-@TempData["AlertType"] alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["AlertMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow-lg rounded-4">
                <div class="card-header border-0 py-4">
                    <h4 class="mb-0 fw-semibold"><i class="bi bi-calendar-plus me-2 text-primary"></i>Booking Details</h4>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-4">
                            <label asp-for="BookingDate" class="form-label fw-medium"></label>
                            <input asp-for="BookingDate" class="form-control form-control-lg shadow-sm" type="datetime-local" />
                            <span asp-validation-for="BookingDate" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="EventID" class="form-label fw-medium"></label>
                            <select asp-for="EventID" class="form-select form-select-lg shadow-sm" asp-items="ViewBag.EventID">
                                <option value="">-- Select an Event --</option>
                            </select>
                            <span asp-validation-for="EventID" class="text-danger small"></span>
                        </div>

                        <div class="mb-5">
                            <label asp-for="VenueID" class="form-label fw-medium"></label>
                            <select asp-for="VenueID" class="form-select form-select-lg shadow-sm" asp-items="ViewBag.VenueID">
                                <option value="">-- Select a Venue --</option>
                            </select>
                            <span asp-validation-for="VenueID" class="text-danger small"></span>
                            <div class="form-text text-muted small mt-1">
                                <i class="bi bi-info-circle me-1 text-warning"></i>
                                Venues already booked on the same date will be rejected to prevent double booking.
                            </div>
                        </div>

                        <div class="d-flex gap-3 justify-content-end pt-4 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary px-5 py-2">Cancel</a>
                            <button type="submit" class="btn btn-primary px-5 py-2 shadow">
                                <i class="bi bi-check-lg me-2"></i> Create Booking
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
