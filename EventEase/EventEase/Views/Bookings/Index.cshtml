@model IEnumerable<EventEase.Models.BookingDetailsView>

@{
    ViewData["Title"] = "Bookings Dashboard";
    var searchQuery = ViewData["SearchQuery"] as string;
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold text-dark mb-1">Bookings Dashboard</h1>
            <p class="text-muted mb-0">Enhanced view with venue and event details</p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm px-4">
            <i class="bi bi-plus-lg me-2"></i> New Booking
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Stats Row -->
    <div class="row mb-4 g-3">
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100 bg-white">
                <div class="card-body d-flex align-items-center">
                    <div class="bg-primary-subtle rounded-circle p-3 me-3">
                        <i class="bi bi-calendar-check fs-4 text-primary"></i>
                    </div>
                    <div>
                        <h6 class="text-muted mb-1">Total Bookings</h6>
                        <h3 class="fw-bold mb-0">@Model.Count()</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100 bg-white">
                <div class="card-body d-flex align-items-center">
                    <div class="bg-success-subtle rounded-circle p-3 me-3">
                        <i class="bi bi-calendar-event fs-4 text-success"></i>
                    </div>
                    <div>
                        <h6 class="text-muted mb-1">Upcoming</h6>
                        <h3 class="fw-bold mb-0">@Model.Count(b => b.BookingDate > DateTime.Now)</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100 bg-white">
                <div class="card-body d-flex align-items-center">
                    <div class="bg-warning-subtle rounded-circle p-3 me-3">
                        <i class="bi bi-calendar-week fs-4 text-warning"></i>
                    </div>
                    <div>
                        <h6 class="text-muted mb-1">This Month</h6>
                        <h3 class="fw-bold mb-0">@Model.Count(b => b.BookingDate.Year == DateTime.Now.Year && b.BookingDate.Month == DateTime.Now.Month)</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100 bg-white">
                <div class="card-body d-flex align-items-center">
                    <div class="bg-info-subtle rounded-circle p-3 me-3">
                        <i class="bi bi-building fs-4 text-info"></i>
                    </div>
                    <div>
                        <h6 class="text-muted mb-1">Unique Venues</h6>
                        <h3 class="fw-bold mb-0">@Model.Select(b => b.VenueName).Distinct().Count()</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Search Bar -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body py-3">
            <form asp-action="Index" method="get" class="d-flex gap-2 align-items-center">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text" name="searchQuery" value="@searchQuery"
                           class="form-control border-start-0 ps-0"
                           placeholder="Search by Booking ID or Event Name..." />
                    <button type="submit" class="btn btn-primary px-4">Search</button>
                    @if (!string.IsNullOrEmpty(searchQuery))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary px-3" title="Clear search">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    }
                </div>
            </form>
            @if (!string.IsNullOrEmpty(searchQuery))
            {
                <small class="text-muted mt-2 d-block">
                    Showing @Model.Count() result(s) for "<strong>@searchQuery</strong>"
                </small>
            }
        </div>
    </div>

    <!-- Enhanced Bookings Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4 py-3 text-muted small fw-semibold">BOOKING ID</th>
                            <th class="py-3 text-muted small fw-semibold">EVENT</th>
                            <th class="py-3 text-muted small fw-semibold">EVENT DATE</th>
                            <th class="py-3 text-muted small fw-semibold">VENUE</th>
                            <th class="py-3 text-muted small fw-semibold">LOCATION</th>
                            <th class="py-3 text-muted small fw-semibold">CAPACITY</th>
                            <th class="py-3 text-muted small fw-semibold">BOOKING DATE</th>
                            <th class="py-3 text-muted small fw-semibold">STATUS</th>
                            <th class="pe-4 py-3 text-muted small fw-semibold">ACTIONS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderByDescending(b => b.BookingDate))
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="badge bg-light text-dark border fw-bold">#@item.BookingID</span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        @if (!string.IsNullOrEmpty(item.EventImageUrl))
                                        {
                                            <img src="@item.EventImageUrl" alt="@item.EventName" class="rounded-2"
                                                 style="width:40px; height:40px; object-fit:cover;" />
                                        }
                                        else
                                        {
                                            <div class="rounded-2 bg-light d-flex align-items-center justify-content-center"
                                                 style="width:40px; height:40px;">
                                                <i class="bi bi-calendar-event text-muted small"></i>
                                            </div>
                                        }
                                        <div>
                                            <div class="fw-semibold text-dark small">@item.EventName</div>
                                            @if (!string.IsNullOrEmpty(item.EventDescription))
                                            {
                                                <div class="text-muted" style="font-size:0.75rem; max-width:200px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">@item.EventDescription</div>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td class="small text-muted">@item.EventDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        @if (!string.IsNullOrEmpty(item.VenueImageUrl))
                                        {
                                            <img src="@item.VenueImageUrl" alt="@item.VenueName" class="rounded-2"
                                                 style="width:40px; height:40px; object-fit:cover;" />
                                        }
                                        <div>
                                            <div class="fw-semibold text-dark small">@item.VenueName</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="small text-muted">
                                    <i class="bi bi-geo-alt me-1"></i>@item.VenueLocation
                                </td>
                                <td class="small text-muted">
                                    <i class="bi bi-people me-1"></i>@item.VenueCapacity.ToString("N0")
                                </td>
                                <td class="small text-muted">@item.BookingDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    @if (item.BookingDate > DateTime.Now)
                                    {
                                        <span class="badge bg-success-subtle text-success px-3 py-2">Upcoming</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary px-3 py-2">Past</span>
                                    }
                                </td>
                                <td class="pe-4">
                                    <div class="d-flex gap-1">
                                        <a asp-action="Details" asp-route-id="@item.BookingID"
                                           class="btn btn-sm btn-outline-primary" title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.BookingID"
                                           class="btn btn-sm btn-outline-secondary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.BookingID"
                                           class="btn btn-sm btn-outline-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-calendar-x fs-1 d-block mb-3 text-muted"></i>
                    <h5 class="text-muted">No bookings found</h5>
                    @if (!string.IsNullOrEmpty(searchQuery))
                    {
                        <p class="text-muted">Try a different search term.</p>
                        <a asp-action="Index" class="btn btn-outline-secondary me-2">Clear Search</a>
                    }
                    <a asp-action="Create" class="btn btn-primary">New Booking</a>
                </div>
            }
        </div>
    </div>
</div>
