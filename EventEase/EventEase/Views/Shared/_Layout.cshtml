            --bs-aspect-ratio: calc(3 / 4 * 100%);
        }

        .venue-image-container {
            min-height: 400px; /* ensures decent height on smaller screens */
        }

        .bg-gradient-overlay {
            background: linear-gradient(to top, rgba(0,0,0,0.75), transparent);
        }

        .event-card {
            transition: all 0.25s ease;
