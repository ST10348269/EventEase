    <style>
        :root {
            --neutral-dark: #1f1f1f;
            --neutral-gray: #4a4a4a;
            --neutral-light: #f8f6f3;
            --accent: #c9a66b; /* Warm gold accent */
            --text-muted: #6b6b6b;
        }

        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            line-height: 1.6;
            color: var(--neutral-gray);
            background-color: var(--neutral-light);
        }

        /* Navbar */
        .navbar {
            background-color: rgba(31, 31, 31, 0.97) !important;
            backdrop-filter: blur(12px);
            transition: all 0.4s ease;
            box-shadow: 0 2px 15px rgba(0, 0, 0, 0.08);
        }

            .navbar.scrolled {
                background-color: rgba(31, 31, 31, 0.99) !important;
            }

        .navbar-brand {
            font-weight: 700;
            font-size: 1.8rem;
            letter-spacing: -0.5px;
            color: white !important;
        }

        .nav-link {
            color: #ddd !important;
            font-weight: 500;
            transition: all 0.3s ease;
        }

            .nav-link:hover {
                color: var(--accent) !important;
            }

        /* Hero Section - Shown only on Home */
        .hero {
            height: 100vh;
            min-height: 700px;
            background: linear-gradient(rgba(31,31,31,0.65), rgba(31,31,31,0.75)), url('https://source.unsplash.com/random/1920x1080/?elegant,event,venue') center/cover no-repeat;
            display: flex;
            align-items: center;
            color: white;
            position: relative;
        }

        .hero-content {
            max-width: 720px;
        }

        .hero h1 {
            font-size: 4.5rem;
            font-weight: 700;
            line-height: 1.1;
            margin-bottom: 1.5rem;
            animation: fadeInUp 1s ease forwards;
        }

        .hero p {
            font-size: 1.35rem;
            margin-bottom: 2.5rem;
            opacity: 0.9;
            animation: fadeInUp 1s ease 0.3s forwards;
            opacity: 0;
        }

        .btn-neutral {
            background-color: white;
            color: var(--neutral-dark);
            font-weight: 600;
            padding: 14px 36px;
            border-radius: 50px;
            transition: all 0.4s ease;
        }

            .btn-neutral:hover {
                transform: translateY(-4px);
                box-shadow: 0 15px 30px rgba(0,0,0,0.15);
            }

        .btn-outline-neutral {
            border: 2px solid white;
            color: white;
            font-weight: 600;
            padding: 14px 36px;
            border-radius: 50px;
            transition: all 0.4s ease;
        }

            .btn-outline-neutral:hover {
                background-color: white;
                color: var(--neutral-dark);
            }

        /* Floating subtle elements */
        .floating {
            position: absolute;
            font-size: 3.5rem;
            opacity: 0.12;
            animation: float 8s ease-in-out infinite;
        }

       

        /* Main content padding */
        .main-content {
            padding-top: 90px;
            min-height: 70vh;
        }

        /* Footer */
        footer {
            background-color: var(--neutral-dark);
            color: #aaa;
            padding: 80px 0 40px;
        }

        .card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

            .card:hover {
                transform: translateY(-8px);
                box-shadow: 0 15px 30px rgba(0, 0, 0, 0.08) !important;
            }

        .card {
            transition: all 0.4s ease;
        }

            .card:hover {
                transform: translateY(-12px);
                box-shadow: 0 20px 40px rgba(0, 0, 0, 0.12) !important;
            }

        .card-img-top {
            transition: transform 0.5s ease;
        }

        .card:hover .card-img-top {
            transform: scale(1.08);
        }

        .badge {
            font-size: 0.85rem;
        }

        .card {
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

            .card:hover {
                transform: translateY(-12px);
                box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.15) !important;
            }

        .card-img-top {
            transition: transform 0.6s ease;
        }

        .venue-card {
            transition: all 0.25s ease;
            border-radius: 12px;
            overflow: hidden;
        }

            .venue-card:hover {
                transform: translateY(-6px);
                box-shadow: 0 12px 24px rgba(0,0,0,0.1) !important;
            }

        .bg-gradient-dark {
            background: linear-gradient(to bottom, transparent, rgba(0,0,0,0.65));
        }

        .hover-lift:hover {
            transform: translateY(-4px);
        }

        .card {
            border-radius: 12px;
        }

        .bg-gradient-light {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        }

        .card {
            border-radius: 16px;
        }

        .form-control:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.15);
        }

        .input-group-lg .form-control,
        .input-group-lg .input-group-text {
            border-radius: 0.5rem;
        }

        .form-label {
            font-size: 1.05rem;
        }

        .bg-gradient-light {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        }

