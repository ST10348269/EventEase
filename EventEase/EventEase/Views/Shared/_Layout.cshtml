    </style>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top">
        <div class="container">
            <a class="navbar-brand" href="/">EventEase</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Venues" asp-action="Index">Venues</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Events" asp-action="Index">Events</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Bookings" asp-action="Index">Bookings</a>
                    </li>
                    <li class="nav-item ms-3">
                        <a href="#" class="btn btn-outline-light btn-sm px-4">Sign In</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Hero Section (Only on Home Page) -->
    <div id="heroSection">
        <section class="hero">
            <div class="floating" style="top: 20%; left: 12%;">✦</div>
            <div class="floating" style="top: 55%; right: 15%; animation-delay: 2s;">✦</div>
            <div class="floating" style="bottom: 30%; left: 25%; animation-delay: 4s;">✦</div>

            <div class="container position-relative z-2">
                <div class="hero-content">
                    <h1>Timeless Events,<br>Beautifully Simple</h1>
                    <p>Discover elegant venues, seamless booking, and everything you need to create unforgettable moments.</p>

                    <div class="d-flex flex-wrap gap-3">
                        <a asp-controller="Venues" asp-action="Index" class="btn btn-neutral">Browse Venues</a>
                        <a asp-controller="Events" asp-action="Index" class="btn btn-outline-neutral">Explore Events</a>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <div class="container">
            @RenderBody()
        </div>
    </div>

    <!-- Footer -->
    <footer>
        <div class="container">
            <div class="row">
                <div class="col-lg-4 mb-4">
                    <h4 class="text-white fw-bold">EventEase</h4>
                    <p class="small">Creating exceptional experiences with elegance and ease.</p>
                </div>
                <div class="col-lg-2 col-md-6 mb-4">
                    <h6 class="text-white">Platform</h6>
                    <ul class="list-unstyled">
                        <li><a href="#" class="text-muted">Venues</a></li>
                        <li><a href="#" class="text-muted">Events</a></li>
                        <li><a href="#" class="text-muted">Bookings</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 col-md-6 mb-4">
                    <h6 class="text-white">Company</h6>
                    <ul class="list-unstyled">
                        <li><a href="#" class="text-muted">About Us</a></li>
                        <li><a href="#" class="text-muted">Contact</a></li>
                        <li><a href="#" class="text-muted">Careers</a></li>
                    </ul>
                </div>
                <div class="col-lg-4">
                    <p class="small text-muted">
                        © 2026 EventEase. All rights reserved.<br>
                        Crafted with care in South Africa.
                    </p>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Navbar scroll effect
        window.addEventListener('scroll', () => {
            const nav = document.querySelector('.navbar');
            if (window.scrollY > 80) {
                nav.classList.add('scrolled');
            } else {
                nav.classList.remove('scrolled');
            }
        });

        // Hide hero on pages other than home
        function checkHeroVisibility() {
            const path = window.location.pathname.toLowerCase();
            const hero = document.getElementById('heroSection');
            if (hero && path !== '/' && path !== '/home' && path !== '/home/index') {
                hero.style.display = 'none';
            }
        }

        window.addEventListener('load', checkHeroVisibility);
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>