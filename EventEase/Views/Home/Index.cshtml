@{
    ViewData["Title"] = "EventEase - Timeless Events Made Simple";
}

<!-- Trust Bar -->
<div class="py-4 border-bottom bg-white">
    <div class="container">
        <div class="row align-items-center justify-content-center text-center text-md-start g-4 small text-muted">
            <div class="col-auto">⭐⭐⭐⭐⭐ <strong>4.9/5</strong> from over 6,200 clients</div>
            <div class="col-auto d-none d-md-block">•</div>
            <div class="col-auto">280+ Curated Venues Across South Africa</div>
            <div class="col-auto d-none d-md-block">•</div>
            <div class="col-auto">Secure Booking • Instant Confirmation</div>
        </div>
    </div>
</div>

<div class="py-5">
    <!-- Features Section -->
    <section class="py-5">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="display-5 fw-bold text-dark">Everything You Need for Extraordinary Events</h2>
                <p class="lead text-muted col-lg-8 mx-auto">
                    Discover elegant venues, manage bookings effortlessly, and create memorable experiences with ease.
                </p>
            </div>

            <div class="row g-5">
                <!-- Feature 1 -->
                <div class="col-lg-4">
                    <div class="text-center">
                        <div class="mx-auto mb-4 d-flex align-items-center justify-content-center"
                             style="width: 90px; height: 90px; background: #f8f6f3; border-radius: 50%; font-size: 2.8rem;">
                            🏛️
                        </div>
                        <h4 class="fw-semibold mb-3">Premium Venues</h4>
                        <p class="text-muted">
                            Hand-selected venues with detailed photos, capacity information, amenities, and real-time availability.
                        </p>
                        <a asp-controller="Venues" asp-action="Index" class="btn btn-link text-decoration-none fw-medium">
                            Browse Venues →
                        </a>
                    </div>
                </div>

                <!-- Feature 2 -->
                <div class="col-lg-4">
                    <div class="text-center">
                        <div class="mx-auto mb-4 d-flex align-items-center justify-content-center"
                             style="width: 90px; height: 90px; background: #f8f6f3; border-radius: 50%; font-size: 2.8rem;">
                            🎉
                        </div>
                        <h4 class="fw-semibold mb-3">Diverse Events</h4>
                        <p class="text-muted">
                            Whether it's a wedding, corporate gala, birthday, or intimate gathering — find or host the perfect event.
                        </p>
                        <a asp-controller="Events" asp-action="Index" class="btn btn-link text-decoration-none fw-medium">
                            Explore Events →
                        </a>
                    </div>
                </div>

                <!-- Feature 3 -->
                <div class="col-lg-4">
                    <div class="text-center">
                        <div class="mx-auto mb-4 d-flex align-items-center justify-content-center"
                             style="width: 90px; height: 90px; background: #f8f6f3; border-radius: 50%; font-size: 2.8rem;">
                            📅
                        </div>
                        <h4 class="fw-semibold mb-3">Seamless Booking</h4>
                        <p class="text-muted">
                            Simple booking process with flexible dates, custom requests, guest tools, and secure payments.
                        </p>
                        <a asp-controller="Bookings" asp-action="Index" class="btn btn-link text-decoration-none fw-medium">
                            View My Bookings →
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- How It Works -->
    <section class="py-5 bg-white">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="display-5 fw-bold">How EventEase Works</h2>
                <p class="lead text-muted">Three simple steps to your perfect event</p>
            </div>

            <div class="row g-5 text-center">
                <div class="col-md-4">
                    <div class="mb-4">
                        <div class="mx-auto rounded-circle bg-dark text-white d-flex align-items-center justify-content-center fw-bold"
                             style="width: 72px; height: 72px; font-size: 1.8rem;">
                            1
                        </div>
                    </div>
                    <h5 class="fw-semibold">Discover</h5>
                    <p class="text-muted px-3">
                        Browse our curated collection of venues and events using powerful filters.
                    </p>
                </div>
                <div class="col-md-4">
                    <div class="mb-4">
                        <div class="mx-auto rounded-circle bg-dark text-white d-flex align-items-center justify-content-center fw-bold"
                             style="width: 72px; height: 72px; font-size: 1.8rem;">
                            2
                        </div>
                    </div>
                    <h5 class="fw-semibold">Customize</h5>
                    <p class="text-muted px-3">
                        Select your date, package, and add personal touches to make it uniquely yours.
                    </p>
                </div>
                <div class="col-md-4">
                    <div class="mb-4">
                        <div class="mx-auto rounded-circle bg-dark text-white d-flex align-items-center justify-content-center fw-bold"
                             style="width: 72px; height: 72px; font-size: 1.8rem;">
                            3
                        </div>
                    </div>
                    <h5 class="fw-semibold">Celebrate</h5>
                    <p class="text-muted px-3">
                        Confirm your booking securely and prepare for an unforgettable experience.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Testimonials -->
    <section class="py-5">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="display-5 fw-bold">Real Stories, Real Moments</h2>
            </div>

            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm h-100 p-4">
                        <div class="mb-3 text-warning">★★★★★</div>
                        <p class="fst-italic">
                            "EventEase made planning our wedding incredibly stress-free.
                            The venue options were stunning and the booking process was seamless."
                        </p>
                        <div class="d-flex align-items-center mt-4">
                            <img src="https://i.pravatar.cc/64?img=32" alt="" class="rounded-circle me-3">
                            <div>
                                <strong>Lebogang & Sipho</strong><br>
                                <small class="text-muted">Wedding • Johannesburg • 2025</small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm h-100 p-4">
                        <div class="mb-3 text-warning">★★★★★</div>
                        <p class="fst-italic">
                            "We hosted our annual corporate conference here.
                            Everything from venue selection to guest management was handled beautifully."
                        </p>
                        <div class="d-flex align-items-center mt-4">
                            <img src="https://i.pravatar.cc/64?img=47" alt="" class="rounded-circle me-3">
                            <div>
                                <strong>Naledi Khumalo</strong><br>
                                <small class="text-muted">Events Manager • Cape Town</small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm h-100 p-4">
                        <div class="mb-3 text-warning">★★★★★</div>
                        <p class="fst-italic">
                            "My surprise 40th birthday party turned out better than I imagined.
                            Thank you EventEase!"
                        </p>
                        <div class="d-flex align-items-center mt-4">
                            <img src="https://i.pravatar.cc/64?img=64" alt="" class="rounded-circle me-3">
                            <div>
                                <strong>David van Wyk</strong><br>
                                <small class="text-muted">Private Event • Durban</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Final Call to Action -->
    <section class="py-5 text-center bg-dark text-white rounded-4 mx-3">
        <div class="container py-5">
            <h2 class="display-5 fw-bold mb-3">Ready to Host Your Next Memorable Event?</h2>
            <p class="lead mb-4 col-lg-8 mx-auto">
                Join thousands who have discovered the easiest way to plan elegant events.
            </p>
            <a asp-controller="Venues" asp-action="Index"
               class="btn btn-light btn-lg px-5 py-3 fs-5 fw-semibold">
                Start Exploring Venues Now
            </a>
        </div>
    </section>
</div>

