@model EventEase.Models.Booking

@{
    ViewData["Title"] = "Booking Details";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-5 gap-3">
        <div>
            <h1 class="fw-bold text-dark mb-1">
                Booking #@Model.BookingID
            </h1>
            <p class="text-muted mb-0">
                @if (Model.BookingDate != default)
                {
                    <span>@Model.BookingDate.ToString("dddd, dd MMMM yyyy • HH:mm")</span>
                }
                else
                {
                    <span class="fst-italic">No booking date set</span>
                }
            </p>
        </div>

        <div class="d-flex gap-3 flex-wrap">
            <a asp-action="Edit" asp-route-id="@Model.BookingID" class="btn btn-primary shadow-sm px-4">
                <i class="bi bi-pencil me-2"></i> Edit Booking
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary shadow-sm px-4">
                <i class="bi bi-arrow-left me-2"></i> Back to Bookings
            </a>
            <a asp-action="Delete" asp-route-id="@Model.BookingID" class="btn btn-outline-danger shadow-sm px-4">
                <i class="bi bi-trash me-1"></i> Delete
            </a>
        </div>
    </div>

    <!-- Main Content Card -->
    <div class="card border-0 shadow-lg rounded-4 bg-white overflow-hidden">
        <div class="row g-0">
            <!-- Left side - Visual area / status -->
            <div class="col-lg-5">
                <div class="position-relative h-100" style="min-height: 380px; background: linear-gradient(135deg, #f8f9fa, #e9ecef);">
                    <div class="d-flex flex-column align-items-center justify-content-center h-100 text-center p-4">
                        <i class="bi bi-calendar-check fs-1 text-primary mb-3"></i>
                        <h5 class="fw-semibold mb-2">Booking Status</h5>
                        <span class="badge @(Model.BookingDate > DateTime.Now ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary") fs-5 px-4 py-2">
                            @(Model.BookingDate > DateTime.Now ? "Upcoming" : "Past / Completed")
                        </span>
                        <small class="text-muted mt-3">
                            Created: @DateTime.Now.ToString("dd MMM yyyy")
                        </small>
                    </div>
                </div>
            </div>

            <!-- Right side - Details -->
            <div class="col-lg-7">
                <div class="p-4 p-lg-5">
                    <h4 class="fw-semibold mb-4 pb-3 border-bottom">
                        <i class="bi bi-info-circle me-2 text-primary"></i>
                        Booking Information
                    </h4>

                    <dl class="row g-4 mb-0">
                        <dt class="col-sm-3 fw-medium text-muted">Booking ID</dt>
                        <dd class="col-sm-9 fs-5 fw-semibold">@Model.BookingID</dd>

                        <dt class="col-sm-3 fw-medium text-muted">Date & Time</dt>
                        <dd class="col-sm-9 fs-5">
                            @if (Model.BookingDate != default)
                            {
                                @Model.BookingDate.ToString("dd MMMM yyyy • HH:mm")
                                <small class="text-muted d-block mt-1">
                                    @(Model.BookingDate > DateTime.Now ? "Future booking" : "Past booking")
                                </small>
                            }
                            else
                            {
                                <span class="text-muted fst-italic">Not specified</span>
                            }
                        </dd>

                        <dt class="col-sm-3 fw-medium text-muted">Event</dt>
                        <dd class="col-sm-9 fs-5">
                            @if (Model.Event != null)
                            {
                                <strong>@Model.Event.EventName</strong>
                                <div class="text-muted small mt-1">
                                    <i class="bi bi-calendar-event me-1"></i>
                                    
                                </div>
                            }
                            else
                            {
                                <span class="text-muted fst-italic">No event linked</span>
                            }
                        </dd>

                        <dt class="col-sm-3 fw-medium text-muted">Venue</dt>
                        <dd class="col-sm-9 fs-5">
                            @if (Model.Venue != null)
                            {
                                <strong>@Model.Venue.VenueName</strong>
                                <div class="text-muted small mt-1">
                                    <i class="bi bi-geo-alt-fill me-1"></i>@Model.Venue.Location
                                </div>
                            }
                            else
                            {
                                <span class="text-muted fst-italic">No venue assigned</span>
                            }
                        </dd>

                        @if (!string.IsNullOrWhiteSpace(Model.Event?.Description))
                        {
                            <dt class="col-sm-3 fw-medium text-muted">Event Description</dt>
                            <dd class="col-sm-9">
                                <div class="text-dark" style="white-space: pre-wrap; line-height: 1.6;">
                                    @(Model.Event.Description.Length > 400
                                                                    ? Model.Event.Description.Substring(0, 400) + "..."
                                                                    : Model.Event.Description)
                            </div>
                        </dd>
                                                }
                    </dl>

                    <!-- Quick actions / notes -->
                    <div class="mt-5 pt-4 border-top">
                        <div class="d-flex gap-4 flex-wrap">
                            <div>
                                <small class="text-muted d-block">Last modified</small>
                                <span>@DateTime.Now.ToString("dd MMM yyyy HH:mm")</span>
                            </div>
                            <div>
                                <small class="text-muted d-block">Status</small>
                                <span class="badge bg-info-subtle text-info px-3 py-2">
                                    Active
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

