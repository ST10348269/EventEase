@model IEnumerable<EventEase.Models.Booking>

@{
    ViewData["Title"] = "Bookings Dashboard";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold text-dark mb-1">Bookings Dashboard</h1>
            <p class="text-muted mb-0">Overview of all venue bookings and reservations</p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm px-4">
            <i class="bi bi-plus-lg me-2"></i> New Booking
        </a>
    </div>

    <!-- Stats Row -->
    <div class="row mb-5 g-4">
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100 bg-white">
                <div class="card-body d-flex align-items-center">
                    <div class="flex-shrink-0 me-3">
                        <div class="bg-primary-subtle rounded-circle p-3">
                            <i class="bi bi-calendar-check fs-4 text-primary"></i>
                        </div>
                    </div>
                    <div>
                        <h6 class="text-muted mb-1">Total Bookings</h6>
                        <h3 class="fw-bold mb-0">@Model.Count()</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100 bg-white">
                <div class="card-body d-flex align-items-center">
                    <div class="flex-shrink-0 me-3">
                        <div class="bg-success-subtle rounded-circle p-3">
                            <i class="bi bi-calendar-event fs-4 text-success"></i>
                        </div>
                    </div>
                    <div>
                        <h6 class="text-muted mb-1">Upcoming</h6>
                        <h3 class="fw-bold mb-0">
                            @Model.Count(b => b.BookingDate > DateTime.Now)
                        </h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100 bg-white">
                <div class="card-body d-flex align-items-center">
                    <div class="flex-shrink-0 me-3">
                        <div class="bg-warning-subtle rounded-circle p-3">
                            <i class="bi bi-calendar-week fs-4 text-warning"></i>
                        </div>
                    </div>
                    <div>
                        <h6 class="text-muted mb-1">This Month</h6>
                        <h3 class="fw-bold mb-0">
                            @Model.Count(b => b.BookingDate.Year == DateTime.Now.Year &&
                            b.BookingDate.Month == DateTime.Now.Month)
                        </h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100 bg-white">
                <div class="card-body d-flex align-items-center">
                    <div class="flex-shrink-0 me-3">
                        <div class="bg-info-subtle rounded-circle p-3">
                            <i class="bi bi-building fs-4 text-info"></i>
                        </div>
                    </div>
                    <div>
                        <h6 class="text-muted mb-1">Unique Venues</h6>
                        <h3 class="fw-bold mb-0">
                            @Model.Select(b => b.VenueID).Distinct().Count()
                        </h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bookings Grid -->
    <div class="row g-4">
        @foreach (var item in Model.OrderByDescending(b => b.BookingDate))
        {
            <div class="col-lg-6 col-xl-4">
                <div class="card border-0 shadow-sm h-100 booking-card hover-lift">
                    <div class="card-body p-4 d-flex flex-column h-100">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h5 class="fw-bold mb-0 text-dark">@item.Event?.EventName</h5>
                            <span class="badge @(item.BookingDate > DateTime.Now ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary") px-3 py-2">
                                @(item.BookingDate > DateTime.Now ? "Upcoming" : "Past")
                            </span>
                        </div>

                        <div class="mb-3">
                            <p class="text-muted small mb-1">
                                <i class="bi bi-calendar-date me-1"></i>
                                @item.BookingDate.ToString("dd MMM yyyy • HH:mm")
                            </p>
                            <p class="text-muted small mb-0">
                                <i class="bi bi-building me-1"></i>
                                @item.Venue?.VenueName
                            </p>
                        </div>

                        <div class="mt-auto d-flex gap-2">
                            <a asp-action="Details" asp-route-id="@item.BookingID"
                               class="btn btn-sm btn-outline-primary flex-fill">
                                <i class="bi bi-eye me-1"></i> Details
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.BookingID"
                               class="btn btn-sm btn-outline-secondary flex-fill">
                                <i class="bi bi-pencil me-1"></i> Edit
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.BookingID"
                               class="btn btn-sm btn-outline-danger flex-fill">
                                <i class="bi bi-trash me-1"></i> Delete
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="col-12">
                <div class="alert alert-info text-center py-5 border-0 shadow-sm">
                    <i class="bi bi-calendar-x fs-1 d-block mb-3 text-muted"></i>
                    <h5>No bookings found</h5>
                    <p class="text-muted mb-3">Start by creating a new booking.</p>
                    <a asp-action="Create" class="btn btn-primary">New Booking</a>
                </div>
            </div>
        }
    </div>
</div>

