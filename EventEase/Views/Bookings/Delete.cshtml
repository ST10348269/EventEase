@model EventEase.Models.Booking

@{
    ViewData["Title"] = "Delete Booking";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h1 class="fw-bold text-dark mb-1">Delete Booking</h1>
            <p class="text-muted mb-0">
                Confirm removal of booking #@Model.BookingID
            </p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary shadow-sm px-4">
            <i class="bi bi-arrow-left me-2"></i> Back to Bookings
        </a>
    </div>

    <!-- Confirmation Card -->
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white">
                <div class="card-header bg-danger-subtle border-0 py-4 d-flex align-items-center">
                    <i class="bi bi-exclamation-triangle-fill text-danger fs-3 me-3"></i>
                    <h4 class="mb-0 fw-semibold text-danger">
                        Confirm Deletion
                    </h4>
                </div>

                <div class="card-body p-4 p-md-5">
                    <p class="lead text-center mb-5 text-muted">
                        Are you sure you want to permanently delete this booking?<br />
                        <strong>This action cannot be undone.</strong>
                    </p>

                    <!-- Booking Preview -->
                    <div class="card bg-light border-0 shadow-sm mb-5">
                        <div class="card-body">
                            <div class="row g-4 align-items-center">
                                <!-- Left: Status / Date -->
                                <div class="col-md-4 text-center">
                                    <div class="mb-3">
                                        <span class="badge @(Model.BookingDate > DateTime.Now ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary") fs-5 px-4 py-2">
                                            @(Model.BookingDate > DateTime.Now ? "Upcoming" : "Past")
                                        </span>
                                    </div>
                                    <h5 class="fw-bold mb-1">
                                        @Model.BookingDate.ToString("dd MMM yyyy")
                                    </h5>
                                    <p class="text-muted small mb-0">
                                        @Model.BookingDate.ToString("HH:mm")
                                    </p>
                                </div>

                                <!-- Right: Event & Venue -->
                                <div class="col-md-8">
                                    <h4 class="fw-bold mb-3">
                                        @if (Model.Event != null)
                                        {
                                            @Model.Event.EventName
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">Unnamed Event</span>
                                        }
                                    </h4>

                                    <dl class="row mb-0 g-2">
                                        <dt class="col-sm-3 text-muted small">Venue</dt>
                                        <dd class="col-sm-9">
                                            @if (Model.Venue != null)
                                            {
                                                <strong>@Model.Venue.VenueName</strong>
                                                <small class="text-muted d-block">@Model.Venue.Location</small>
                                            }
                                            else
                                            {
                                                <span class="text-muted fst-italic">No venue</span>
                                            }
                                        </dd>

                                        <dt class="col-sm-3 text-muted small">Booking ID</dt>
                                        <dd class="col-sm-9 small text-muted">@Model.BookingID</dd>

                                        
                                    </dl>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="BookingID" />

                        <div class="d-flex gap-3 justify-content-center mt-5 pt-4 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary px-5 py-3 fs-5">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-danger px-5 py-3 fs-5 shadow">
                                <i class="bi bi-trash-fill me-2"></i> Yes, Delete Booking
                            </button>
                        </div>
                    </form>
                </div>

                <div class="card-footer bg-light border-0 text-center py-3 small text-muted">
                    This booking will be removed from the system permanently
                </div>
            </div>
        </div>
    </div>
</div>

