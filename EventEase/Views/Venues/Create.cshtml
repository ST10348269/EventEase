@model EventEase.Models.Venue

@{
    ViewData["Title"] = "Add New Venue";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h1 class="fw-bold text-dark mb-1">Add New Venue</h1>
            <p class="text-muted mb-0">Enter the details for your new event space</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary shadow-sm px-4">
            <i class="bi bi-arrow-left me-2"></i> Back to Venues
        </a>
    </div>

    <!-- Form Card -->
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white">
                <div class="card-header bg-gradient-light border-0 py-4">
                    <h4 class="mb-0 fw-semibold text-dark">
                        <i class="bi bi-building-add me-2 text-primary"></i>
                        Venue Information
                    </h4>
                </div>

                <div class="card-body p-4 p-md-5">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none" role="alert"></div>

                        <!-- Venue Name -->
                        <div class="mb-4">
                            <label asp-for="VenueName" class="form-label fw-medium text-dark"></label>
                            <input asp-for="VenueName" class="form-control form-control-lg shadow-sm"
                                   placeholder="e.g. Skyline Convention Center" />
                            <div class="invalid-feedback">
                                <span asp-validation-for="VenueName"></span>
                            </div>
                        </div>

                        <!-- Location -->
                        <div class="mb-4">
                            <label asp-for="Location" class="form-label fw-medium text-dark"></label>
                            <input asp-for="Location" class="form-control form-control-lg shadow-sm"
                                   placeholder="e.g. Sandton, Johannesburg" />
                            <div class="invalid-feedback">
                                <span asp-validation-for="Location"></span>
                            </div>
                        </div>

                        <!-- Capacity -->
                        <div class="mb-4">
                            <label asp-for="Capacity" class="form-label fw-medium text-dark"></label>
                            <div class="input-group input-group-lg">
                                <input asp-for="Capacity" class="form-control shadow-sm"
                                       type="number" min="1" placeholder="e.g. 350" />
                                <span class="input-group-text bg-light">people</span>
                            </div>
                            <div class="invalid-feedback">
                                <span asp-validation-for="Capacity"></span>
                            </div>
                        </div>

                        <!-- Image URL -->
                        <div class="mb-5">
                            <label asp-for="ImageUrl" class="form-label fw-medium text-dark"></label>
                            <input asp-for="ImageUrl" class="form-control form-control-lg shadow-sm"
                                   placeholder="https://example.com/images/venue.jpg" />
                            <div class="form-text text-muted mt-1 small">
                                Provide a direct link to a high-quality venue photo (JPG/PNG)
                            </div>
                            <div class="invalid-feedback">
                                <span asp-validation-for="ImageUrl"></span>
                            </div>

                            <!-- Optional live preview (bonus modern touch) -->
                            <div class="mt-3">
                                <small class="text-muted">Preview:</small>
                                <div class="mt-2 border rounded-3 overflow-hidden shadow-sm bg-light"
                                     style="height: 160px; background-size: cover; background-position: center;"
                                     id="imagePreview"
                                     data-default="https://via.placeholder.com/600x300?text=Venue+Preview">
                                </div>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="d-flex gap-3 justify-content-end mt-5 pt-4 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary px-5 py-2">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-primary px-5 py-2 shadow">
                                <i class="bi bi-check-lg me-2"></i> Create Venue
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Optional: Simple live image preview -->
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const imageInput = document.querySelector('input#ImageUrl');
        const previewDiv = document.getElementById('imagePreview');

        if (imageInput && previewDiv) {
            imageInput.addEventListener('input', function () {
                const url = this.value.trim();
                if (url) {
                    previewDiv.style.backgroundImage = `url('${url}')`;
                } else {
                    previewDiv.style.backgroundImage = `url('${previewDiv.dataset.default}')`;
                }
            });

            // Trigger once on load if there's already a value
            if (imageInput.value) {
                imageInput.dispatchEvent(new Event('input'));
            }
        }
    });
</script>

