@model EventEase.Models.Venue

@{
    ViewData["Title"] = "Delete Venue";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h1 class="fw-bold text-dark mb-1">Delete Venue</h1>
            <p class="text-muted mb-0">Confirm removal of <strong>@Model.VenueName</strong></p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary shadow-sm px-4">
            <i class="bi bi-arrow-left me-2"></i> Back to Venues
        </a>
    </div>

    <!-- Confirmation Card -->
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white">
                <div class="card-header bg-danger-subtle border-0 py-4 d-flex align-items-center">
                    <i class="bi bi-exclamation-triangle-fill text-danger fs-3 me-3"></i>
                    <h4 class="mb-0 fw-semibold text-danger">
                        Confirm Deletion
                    </h4>
                </div>

                <div class="card-body p-4 p-md-5">
                    <p class="lead text-center mb-4 text-muted">
                        Are you sure you want to permanently delete this venue?<br />
                        This action cannot be undone.
                    </p>

                    <!-- Venue Preview Card -->
                    <div class="card bg-light border-0 shadow-sm mb-5">
                        <div class="card-body">
                            <div class="row g-4 align-items-center">
                                <!-- Image -->
                                <div class="col-md-4">
                                    <div class="ratio ratio-4x3 rounded-3 overflow-hidden shadow-sm">
                                        <img src="@Model.ImageUrl"
                                             class="object-fit-cover"
                                             alt="@Model.VenueName"
                                             onerror="this.src='https://via.placeholder.com/400x300?text=No+Image';" />
                                    </div>
                                </div>

                                <!-- Details -->
                                <div class="col-md-8">
                                    <h4 class="fw-bold mb-3">@Model.VenueName</h4>
                                    <dl class="row mb-0">
                                        <dt class="col-sm-3 text-muted small">Location</dt>
                                        <dd class="col-sm-9">@Model.Location</dd>

                                        <dt class="col-sm-3 text-muted small">Capacity</dt>
                                        <dd class="col-sm-9">@Model.Capacity people</dd>

                                        <dt class="col-sm-3 text-muted small">Image URL</dt>
                                        <dd class="col-sm-9 text-truncate">
                                            <a href="@Model.ImageUrl" target="_blank" class="text-primary small">@Model.ImageUrl</a>
                                        </dd>
                                    </dl>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Actions -->
                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="VenueID" />

                        <div class="d-flex gap-3 justify-content-center mt-5 pt-4 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary px-5 py-3 fs-5">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-danger px-5 py-3 fs-5 shadow">
                                <i class="bi bi-trash-fill me-2"></i> Yes, Delete Venue
                            </button>
                        </div>
                    </form>
                </div>

                <div class="card-footer bg-light border-0 text-center py-3 small text-muted">
                    Venue ID: @Model.VenueID • This venue will be removed from all records
                </div>
            </div>
        </div>
    </div>
</div>

